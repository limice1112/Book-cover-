  g.fillStyle='#f3ede0';
  g.fillRect(0,0,256,256);
  for(let x=0;x<256;x+=3){
    g.fillStyle=x%6===0?'rgba(155,140,115,0.28)':'rgba(255,255,255,0.45)';
    g.fillRect(x,0,1.5,256);
  }
  const vg=g.createLinearGradient(0,0,256,0);
  vg.addColorStop(0,'rgba(0,0,0,0.16)');
  vg.addColorStop(0.12,'rgba(0,0,0,0)');
  vg.addColorStop(0.88,'rgba(0,0,0,0)');
  vg.addColorStop(1,'rgba(0,0,0,0.14)');
  g.fillStyle=vg;
  g.fillRect(0,0,256,256);
  const t=new THREE.CanvasTexture(c);
  t.anisotropy=4;
  return t;
}

function makeFloorShadowTexture(){
  const c=document.createElement('canvas');
  c.width=256;c.height=256;
  const g=c.getContext('2d');
  const r=g.createRadialGradient(128,128,8,128,128,124);
  r.addColorStop(0,'rgba(8,14,34,0.46)');
  r.addColorStop(0.45,'rgba(8,14,34,0.20)');
  r.addColorStop(1,'rgba(8,14,34,0)');
  g.fillStyle=r;
  g.fillRect(0,0,256,256);
  return new THREE.CanvasTexture(c);
}

function init3D(){
  if(typeof THREE==='undefined')return;
  renderer=new THREE.WebGLRenderer({canvas:glCanvas,alpha:true,antialias:true,powerPreference:'high-performance'});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  renderer.outputEncoding=THREE.sRGBEncoding;

  scene=new THREE.Scene();
  camera=new THREE.PerspectiveCamera(38,1,0.1,40);
  camera.position.set(0,0.06,4.55);
  camera.lookAt(0,0,0);

  const ambLight=new THREE.AmbientLight(0xffffff,0.78);
  scene.add(ambLight);

  const keyLight=new THREE.DirectionalLight(0xffffff,0.68);
  keyLight.position.set(2.8,4.2,5.0);
  scene.add(keyLight);

  const rimLight=new THREE.DirectionalLight(0xdbe6ff,0.34);
  rimLight.position.set(-3.5,1.8,-3.2);
  scene.add(rimLight);

  const frontTex=new THREE.CanvasTexture(frontDispCv);
  const backTex=new THREE.CanvasTexture(backDispCv);
  const spineTex=new THREE.CanvasTexture(spineDispCv);
  [frontTex,backTex,spineTex].forEach(t=>{
    t.encoding=THREE.sRGBEncoding;
    t.anisotropy=4;
  });
  window._bookTex={front:frontTex,back:backTex,spine:spineTex};

  const edgeTex=makePageEdgeTexture();

  const frontMat=new THREE.MeshStandardMaterial({map:frontTex,roughness:0.38,metalness:0.04});
  const backMat=new THREE.MeshStandardMaterial({map:backTex,roughness:0.42,metalness:0.04});
  const spineMat=new THREE.MeshStandardMaterial({map:spineTex,roughness:0.36,metalness:0.05});
  const edgeMat=new THREE.MeshStandardMaterial({map:edgeTex,roughness:0.78,metalness:0.0});

  const geo=new THREE.BoxGeometry(0.42,2.56,1.6);
  bookMesh=new THREE.Mesh(geo,[frontMat,backMat,edgeMat,edgeMat,spineMat,edgeMat]);
  window._bookMesh=bookMesh;

  bookGroup=new THREE.Group();
  bookGroup.add(bookMesh);
  bookGroup.rotation.set(rotX,rotY,0);
  scene.add(bookGroup);

  const shGeo=new THREE.PlaneGeometry(2.5,1.35);
  const shMat=new THREE.MeshBasicMaterial({
    map:makeFloorShadowTexture(),
    transparent:true,
    depthWrite:false,
    opacity:0.72
  });
  shadowMesh=new THREE.Mesh(shGeo,shMat);
  shadowMesh.rotation.x=-Math.PI/2;
  shadowMesh.position.set(0,-1.50,0);
  scene.add(shadowMesh);

  resize3D();
}

function resize3D(){
  if(!renderer||!camera)return;
  const rect=glWrap.getBoundingClientRect();
  const w=Math.max(1,rect.width);
  const h=Math.max(1,rect.height);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  renderer.setSize(w,h,false);
  camera.aspect=w/h;
  camera.updateProjectionMatrix();
}

/* Splash Screen Transition: Book flies into editor */
function dismissIntro(){
  if(!introActive)return;
  introActive=false;
  const splash=$('#splash');
  document.body.classList.remove('intro-active');
  document.body.classList.add('ui-ready');

  if(reducedMotion||!bookGroup){
    splash.hidden=true;
    glWrap.classList.remove('flying');
    resize3D();
    return;
  }

  splash.classList.add('closing');
  setTimeout(()=>{splash.hidden=true},620);

  flightStartRect={left:0,top:0,width:window.innerWidth,height:window.innerHeight};
  flightActive=true;
  flightT=0;
}

$('#start-btn').onclick=dismissIntro;

/* Pointer Controls on Book Stage (touch-action: pan-y preserved) */
bookStage.addEventListener('pointerdown',e=>{
  if(introActive||flightActive)return;
  dragging=true;
  lastX=e.clientX;
  lastY=e.clientY;
  velY=0;
  lastInteractTime=performance.now();
  if(e.pointerType==='mouse'&&bookStage.setPointerCapture){
    try{bookStage.setPointerCapture(e.pointerId)}catch(err){}
  }
},{passive:true});

window.addEventListener('pointermove',e=>{
  ptrX=(e.clientX/Math.max(1,window.innerWidth)-0.5)*2;
  ptrY=(e.clientY/Math.max(1,window.innerHeight)-0.5)*2;
  if(!dragging)return;
  const dx=e.clientX-lastX;
  const dy=e.clientY-lastY;
  lastX=e.clientX;
  lastY=e.clientY;
  rotY+=dx*0.009;
  rotX=Math.max(-0.45,Math.min(0.45,rotX+dy*0.004));
  velY=dx*0.009;
  lastInteractTime=performance.now();
},{passive:true});

function endDrag(){
  if(!dragging)return;
  dragging=false;
  lastInteractTime=performance.now();
}
window.addEventListener('pointerup',endDrag,{passive:true});
window.addEventListener('pointercancel',endDrag,{passive:true});

/* Auto-rotate toggle button */
function syncRotBtn(){
  const btn=$('#rot-btn');
  if(btn)btn.setAttribute('aria-pressed',String(autoRotate));
}
$('#rot-btn').onclick=()=>{
  autoRotate=!autoRotate;
  if(autoRotate)lastInteractTime=performance.now()-2600;
  syncRotBtn();
};

/* Theme cycle button */
function applyTheme(){
  const root=document.documentElement;
  if(S.theme===1)root.dataset.theme='light';
  else if(S.theme===2)root.dataset.theme='dark';
  else delete root.dataset.theme;
  const tb=$('#th-btn');
  if(tb)tb.textContent=L[S.ui]['th'+S.theme];
  updateTargetThemeColors();
}
$('#th-btn').onclick=()=>{
  S.theme=(S.theme+1)%3;
  applyTheme();
};

rmQuery.addEventListener('change',e=>{
  reducedMotion=e.matches;
  if(reducedMotion){
    autoRotate=false;
    syncRotBtn();
  }
});

/* Main 60fps Animation Loop with Page Visibility Pause */
let rafId=null;
let lastTime=performance.now();
let elapsed=0;

function tick(now){
  if(document.hidden){
    rafId=null;
    return;
  }
  const dt=Math.min((now-lastTime)/1000,0.05);
  lastTime=now;
  elapsed+=dt;

  renderBg(dt,elapsed);

  if(texFadeT<1){
    texFadeT=Math.min(1,texFadeT+dt/0.4);
    const ease=texFadeT<.5?2*texFadeT*texFadeT:1-Math.pow(-2*texFadeT+2,2)/2;
    syncDisplayTextures(ease);
  }

  let hopY=0,hopTilt=0;
  if(hopT<1){
    hopT=Math.min(1,hopT+dt/0.42);
    const wave=Math.sin(hopT*Math.PI);
    hopY=wave*0.14;
    hopTilt=wave*0.07;
  }

  let flightSpin=0,flightScale=1,flightOffX=0,flightOffY=0;
  if(flightActive){
    flightT=Math.min(1,flightT+dt/0.65);
    const ease=1-Math.pow(1-flightT,3);
    flightSpin=(1-ease)*Math.PI*2;
    flightScale=lerp(1.18,1.0,ease);

    const endR=bookStage.getBoundingClientRect();
    const startCx=flightStartRect.left+flightStartRect.width/2;
    const startCy=flightStartRect.top+flightStartRect.height*0.46;
    const endCx=endR.left+endR.width/2;
    const endCy=endR.top+endR.height/2;

    const curCx=lerp(startCx,endCx,ease);
    const curCy=lerp(startCy,endCy,ease);
    const visH=2*camera.position.z*Math.tan(THREE.MathUtils.degToRad(camera.fov/2));
    const worldPerPx=visH/Math.max(1,window.innerHeight);

    flightOffX=(curCx-window.innerWidth/2)*worldPerPx;
    flightOffY=-(curCy-window.innerHeight/2)*worldPerPx;

    if(flightT>=1){
      flightActive=false;
      glWrap.classList.remove('flying');
      resize3D();
    }
  }

  if(bookGroup&&renderer&&scene&&camera){
    if(introActive){
      if(!reducedMotion)rotY+=0.34*dt;
    }else if(!dragging){
      if(Math.abs(velY)>0.0001){
        rotY+=velY;
        velY*=Math.pow(0.04,dt);
      }
      if(autoRotate&&!reducedMotion&&(now-lastInteractTime>=2500)){
        rotY+=0.42*dt;
        rotX+=(0.06-rotX)*Math.min(1,dt*2.5);
      }
    }

    const floatY=(reducedMotion||introActive)?0:Math.sin(elapsed*1.65)*0.065;
    const idleTiltX=reducedMotion?0:Math.sin(elapsed*1.1)*0.032;
    const idleTiltZ=reducedMotion?0:Math.cos(elapsed*0.92)*0.024;
    const ptrTiltY=reducedMotion?0:smoothPtrX*0.08;
    const ptrTiltX=reducedMotion?0:smoothPtrY*0.05;

    bookGroup.position.set(flightOffX,floatY+hopY+flightOffY,0);
    bookGroup.scale.setScalar(flightScale);
    bookGroup.rotation.set(
      rotX+idleTiltX+ptrTiltX,
      rotY+ptrTiltY+flightSpin,
      idleTiltZ+hopTilt
    );

    if(shadowMesh){
      shadowMesh.visible=!introActive&&!flightActive;
      const lift=floatY+hopY;
      const shScale=Math.max(0.65,1-lift*1.35);
      shadowMesh.scale.set(shScale,shScale,1);
      shadowMesh.material.opacity=Math.max(0.28,0.72-lift*1.5);
      shadowMesh.rotation.z=(rotY+Math.PI/2)*0.25;
    }

    renderer.render(scene,camera);
  }

  rafId=requestAnimationFrame(tick);
}

document.addEventListener('visibilitychange',()=>{
  if(document.hidden){
    if(rafId){cancelAnimationFrame(rafId);rafId=null}
  }else{
    lastTime=performance.now();
    if(!rafId)rafId=requestAnimationFrame(tick);
  }
});

window.addEventListener('resize',()=>{
  resizeBg();
  resize3D();
});

/* UI Sync & Localization */
function sync(){
  const T=S.tx[S.cl];
  $('#it').value=T[0];$('#is').value=T[1];$('#ia').value=T[2];$('#fs').value=S.f;$('#iz').value=S.z;
  $('#tc').value=S.c;$('#fr').checked=S.fr;$('#c1').value=S.a;$('#c2').value=S.b;$('#dk').value=S.dk;
}

function R(){
  const l=L[S.ui],li=LG.indexOf(S.ui);
  document.documentElement.lang=S.ui;
  document.querySelectorAll('[data-i]').forEach(e=>e.textContent=l[e.dataset.i]);
  const setUiLang=v=>{
    S.ui=v;
    if(introActive){S.cl=v;sync();draw(true)}
    R();
  };
  seg('#uil',LG.map((k,i)=>[LN[i],k]),S.ui,setUiLang);
  seg('#sp-uil',LG.map((k,i)=>[LN[i],k]),S.ui,setUiLang);
  seg('#tabs',[l.tpl,l.txt,l.bg,l.sz].map((x,i)=>[x,i]),S.tab,v=>{S.tab=v;R()});
  document.querySelectorAll('.panel').forEach((p,i)=>p.hidden=i!==S.tab);
  $('#tg').replaceChildren(...TPL.map((o,i)=>{
    const b=E('button',{type:'button',className:'tp',textContent:o.n[li]});
    b.style.cssText=`background:linear-gradient(135deg,${o.a},${o.b});color:${o.c}`;
    b.setAttribute('aria-pressed',i===S.tp);b.onclick=()=>tpl(i);return b}));
  seg('#cll',LG.map((k,i)=>[LN[i],k]),S.cl,v=>{S.cl=v;sync();R();triggerTexTransition(false)});
  seg('#pg',[l.p0,l.p1,l.p2].map((x,i)=>[x,i]),S.po,v=>{S.po=v;R();draw(false)});
  seg('#sg',P.map((p,i)=>[l['s'+i]+' '+p[0]+'×'+p[1],i]),S.sz,v=>{S.sz=v;R();draw(false)});
  const tb=$('#th-btn');
  if(tb)tb.textContent=l['th'+S.theme];
  syncRotBtn();
}

function tpl(i){
  const o=TPL[i];
  Object.assign(S,{tp:i,a:o.a,b:o.b,c:o.c,f:o.f,fr:!!o.r});
  updateTargetThemeColors();
  sync();R();
  triggerTexTransition(true);
}

let msgTimer=null;
function say(s){
  const m=$('#msg');
  m.textContent='✓ '+s;
  m.classList.add('show');
  clearTimeout(msgTimer);
  msgTimer=setTimeout(()=>{m.classList.remove('show')},3200);
}

FONTS.forEach((f,i)=>$('#fs').add(new Option(f.n,i)));
$('#it').oninput=e=>{S.tx[S.cl][0]=e.target.value;draw(false)};
$('#is').oninput=e=>{S.tx[S.cl][1]=e.target.value;draw(false)};
$('#ia').oninput=e=>{S.tx[S.cl][2]=e.target.value;draw(false)};
$('#fs').onchange=e=>{S.f=+e.target.value;triggerTexTransition(false)};
$('#iz').oninput=e=>{S.z=+e.target.value;draw(false)};
$('#tc').oninput=e=>{S.c=e.target.value;triggerTexTransition(false)};
$('#fr').onchange=e=>{S.fr=e.target.checked;draw(false)};
$('#c1').oninput=e=>{S.a=e.target.value;updateTargetThemeColors();triggerTexTransition(false)};
$('#c2').oninput=e=>{S.b=e.target.value;updateTargetThemeColors();triggerTexTransition(false)};
$('#dk').oninput=e=>{S.dk=+e.target.value;draw(false)};
$('#rm').onclick=()=>{S.img=null;draw(false)};
$('#fi').onchange=e=>{
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader;
  r.onload=()=>{const im=new Image;im.onload=()=>{S.img=im;draw(false)};im.src=r.result};
  r.readAsDataURL(f);e.target.value='';
};
$('#sv').onclick=()=>cv.toBlob(async b=>{
  let dl=null;
  try{dl=window.claude&&claude.use?await claude.use('downloads'):null}catch(e){}
  if(dl){
    try{await dl.save({filename:'cover-'+S.cl+'.png',data:b});say(L[S.ui].saved);return}
    catch(e){if(e&&e.code==='declined')return}
  }
  $('#out').src=cv.toDataURL('image/png');
  $('#ow').hidden=false;
  $('#ow').scrollIntoView({behavior:reducedMotion?'auto':'smooth'});
  say(L[S.ui].saved);
},'image/png');

/* Initialize Everything */
applyTheme();
tpl(0);
init3D();
rafId=requestAnimationFrame(tick);
</script>
