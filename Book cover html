function drawBackAndSpine(){
  const F=FONTS[S.f],T=S.tx[S.cl];
  const ft=p=>`${F.w} ${p}px ${F.f}`;
  const sf=p=>`400 ${p}px "PT Sans","PT Serif",sans-serif`;
  const af=p=>`700 ${p}px "PT Sans","PT Serif",sans-serif`;

  /* Back cover (1600 x 2560) */
  const BW=1600,BH=2560,bu=BW/100;
  const bg=backCv.getContext('2d');
  const bgr=bg.createLinearGradient(0,0,BW*.35,BH);
  bgr.addColorStop(0,S.b);bgr.addColorStop(1,S.a);
  bg.fillStyle=bgr;bg.fillRect(0,0,BW,BH);
  bg.fillStyle='rgba(0,0,0,0.08)';bg.fillRect(0,0,BW,BH);

  bg.fillStyle=bg.strokeStyle=S.c;
  bg.textAlign='center';bg.textBaseline='middle';
  if(S.fr){
    bg.globalAlpha=.65;bg.lineWidth=Math.max(2,bu*.6);
    bg.strokeRect(5*bu,5*bu,BW-10*bu,BH-10*bu);
    bg.globalAlpha=1;
  }
  const bmw=BW*.74;
  const bau=fit(bg,T[2],56,af,bmw);
  bg.globalAlpha=.85;
  bg.font=af(bau.px);
  bau.ln.forEach((l,i)=>bg.fillText(l,BW/2,BH*.15+i*bau.px*1.2));
  bg.globalAlpha=1;

  const bti=fit(bg,T[0],118,ft,bmw);
  let by=BH*.34;
  bg.font=ft(bti.px);
  bti.ln.forEach(l=>{bg.fillText(l,BW/2,by);by+=bti.px*1.16});

  if(T[1]){
    by+=36;
    const bsu=fit(bg,T[1],54,sf,bmw);
    bg.globalAlpha=.88;
    bg.font=sf(bsu.px);
    bsu.ln.forEach(l=>{bg.fillText(l,BW/2,by);by+=bsu.px*1.3});
    bg.globalAlpha=1;
  }

  /* Decorative rule & minimalist ISBN barcode on back cover */
  bg.globalAlpha=.45;
  bg.fillRect(BW*.36,BH*.74,BW*.28,4);
  bg.globalAlpha=.82;
  const bars=[3,1,2,4,1,2,1,3,2,1,4,2,1,3,1,2,3,2,1,4,1,2,3,1,2,1,3];
  const totalUnits=bars.reduce((a,b)=>a+b,0);
  const bcW=340,bcH=110,bcX=(BW-bcW)/2,bcY=BH*.81;
  let cx=bcX;
  bars.forEach((u,idx)=>{
    const w=(u/totalUnits)*bcW;
    if(idx%2===0)bg.fillRect(cx,bcY,Math.max(2,w*.86),bcH);
    cx+=w;
  });
  bg.font='700 26px "PT Sans",monospace';
  bg.fillText('ISBN 978-601-00-2026-8',BW/2,bcY+bcH+30);
  bg.globalAlpha=1;

  /* Spine (420 x 2560 -> matches 0.42 x 2.56 without stretching) */
  const SW=420,SH=2560;
  const sg=spineCv.getContext('2d');
  const sgr=sg.createLinearGradient(0,0,0,SH);
  sgr.addColorStop(0,S.a);sgr.addColorStop(1,S.b);
  sg.fillStyle=sgr;sg.fillRect(0,0,SW,SH);

  /* Realistic spine crease shading along left/right edges */
  const crease=sg.createLinearGradient(0,0,SW,0);
  crease.addColorStop(0,'rgba(0,0,0,0.28)');
  crease.addColorStop(0.14,'rgba(255,255,255,0.12)');
  crease.addColorStop(0.5,'rgba(0,0,0,0.03)');
  crease.addColorStop(0.86,'rgba(255,255,255,0.10)');
  crease.addColorStop(1,'rgba(0,0,0,0.28)');
  sg.fillStyle=crease;sg.fillRect(0,0,SW,SH);

  if(S.fr){
    sg.strokeStyle=S.c;sg.globalAlpha=.65;sg.lineWidth=8;
    sg.strokeRect(28,44,SW-56,SH-88);
    sg.globalAlpha=1;
  }

  /* Spine vertical text (top-to-bottom +90deg, crisp & unmirrored) */
  sg.save();
  sg.translate(SW/2,SH*.46);
  sg.rotate(Math.PI/2);
  sg.fillStyle=S.c;
  sg.textAlign='center';
  sg.textBaseline='middle';
  let spPx=148;
  const spMaxW=SH*.66;
  while(spPx>46){
    sg.font=`${F.w} ${spPx}px ${F.f}`;
    if(sg.measureText(T[0]).width<=spMaxW)break;
    spPx*=0.92;
  }
  sg.fillText(T[0],0,0);
  sg.restore();

  /* Author at bottom of spine */
  if(T[2]){
    sg.save();
    sg.translate(SW/2,SH*.88);
    sg.rotate(Math.PI/2);
    sg.fillStyle=S.c;
    sg.globalAlpha=.85;
    sg.textAlign='center';
    sg.textBaseline='middle';
    let auPx=64;
    while(auPx>28){
      sg.font=`700 ${auPx}px "PT Sans","PT Serif",sans-serif`;
      if(sg.measureText(T[2]).width<=SH*.18)break;
      auPx*=0.9;
    }
    sg.fillText(T[2],0,0);
    sg.restore();
  }
}

function triggerTexTransition(withHop=false){
  if(texReady&&!reducedMotion){
    frontPrevCv.width=frontDispCv.width;frontPrevCv.height=frontDispCv.height;
    frontPrevCv.getContext('2d').drawImage(frontDispCv,0,0);
    backPrevCv.getContext('2d').drawImage(backDispCv,0,0);
    spinePrevCv.getContext('2d').drawImage(spineDispCv,0,0);
    texFadeT=0;
    if(withHop)hopT=0;
  }else{
    texFadeT=1;
  }
  draw(false);
}

function syncDisplayTextures(alpha){
  if(frontDispCv.width!==cv.width||frontDispCv.height!==cv.height){
    frontDispCv.width=cv.width;frontDispCv.height=cv.height;
  }
  const fg=frontDispCv.getContext('2d');
  const bg=backDispCv.getContext('2d');
  const sg=spineDispCv.getContext('2d');
  if(alpha>=1||!texReady){
    fg.clearRect(0,0,frontDispCv.width,frontDispCv.height);
    fg.drawImage(cv,0,0);
    bg.clearRect(0,0,1600,2560);
    bg.drawImage(backCv,0,0);
    sg.clearRect(0,0,420,2560);
    sg.drawImage(spineCv,0,0);
    texReady=true;
  }else{
    fg.globalAlpha=1;
    fg.drawImage(frontPrevCv,0,0,frontDispCv.width,frontDispCv.height);
    fg.globalAlpha=alpha;
    fg.drawImage(cv,0,0);
    fg.globalAlpha=1;

    bg.globalAlpha=1;
    bg.drawImage(backPrevCv,0,0);
    bg.globalAlpha=alpha;
    bg.drawImage(backCv,0,0);
    bg.globalAlpha=1;

    sg.globalAlpha=1;
    sg.drawImage(spinePrevCv,0,0);
    sg.globalAlpha=alpha;
    sg.drawImage(spineCv,0,0);
    sg.globalAlpha=1;
  }
  if(window._bookTex){
    window._bookTex.front.needsUpdate=true;
    window._bookTex.back.needsUpdate=true;
    window._bookTex.spine.needsUpdate=true;
  }
}

function draw(smooth=false){
  if(smooth&&texReady&&!reducedMotion){
    triggerTexTransition(false);
    return;
  }
  const[W,H]=P[S.sz],g=cv.getContext('2d');
  if(cv.width!==W||cv.height!==H){cv.width=W;cv.height=H}
  const u=W/100,F=FONTS[S.f],T=S.tx[S.cl],ft=p=>`${F.w} ${p}px ${F.f}`;
  const sf=p=>`400 ${p}px "PT Sans","PT Serif",sans-serif`,af=p=>`700 ${p}px "PT Sans","PT Serif",sans-serif`;
  const gr=g.createLinearGradient(0,0,W*.35,H);gr.addColorStop(0,S.a);gr.addColorStop(1,S.b);
  g.fillStyle=gr;g.fillRect(0,0,W,H);
  if(S.img){
    const r=Math.max(W/S.img.width,H/S.img.height),w=S.img.width*r,h=S.img.height*r;
    g.drawImage(S.img,(W-w)/2,(H-h)/2,w,h);
    g.fillStyle=`rgba(0,0,0,${S.dk/100})`;g.fillRect(0,0,W,H);
  }
  g.fillStyle=g.strokeStyle=S.c;g.textAlign='center';g.textBaseline='middle';
  if(S.fr){g.globalAlpha=.75;g.lineWidth=Math.max(2,u*.6);g.strokeRect(5*u,5*u,W-10*u,H-10*u);g.globalAlpha=1}
  const mw=W*.78,a=fit(g,T[0],S.z*u,ft,mw),b=fit(g,T[1],a.px*.36,sf,mw),au=fit(g,T[2],S.z*u*.36,af,mw);
  const bh=a.ln.length*a.px*1.12+(T[1]?a.px*.3+b.ln.length*b.px*1.25:0);
  let y=S.po===0?H*.13:S.po===1?(H-bh)/2:H*.87-bh;
  if(S.img){g.shadowColor='rgba(0,0,0,.45)';g.shadowBlur=u*1.5}
  g.font=ft(a.px);a.ln.forEach(l=>{g.fillText(l,W/2,y+a.px*.56);y+=a.px*1.12});
  if(T[1]){y+=a.px*.3;g.font=sf(b.px);b.ln.forEach(l=>{g.fillText(l,W/2,y+b.px*.62);y+=b.px*1.25})}
  g.font=af(au.px);au.ln.forEach((l,i)=>g.fillText(l,W/2,(S.po===2?H*.09:H*.91)+i*au.px*1.2));
  g.shadowBlur=0;

  drawBackAndSpine();
  syncDisplayTextures(texFadeT>=1?1:0);

  if(window._bookMesh){
    const ratio=(W/H)/(1600/2560);
    window._bookMesh.scale.set(1,1,ratio);
  }

  $('#dim').textContent=W+'×'+H;
  cv.setAttribute('aria-label',T[0]+', '+T[2]);

  const kzSample='ӘҒҚҢӨҰҮҺІәғқңөұүһі';
