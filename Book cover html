<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Обложка книги · Мұқаба · Book cover</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Lobster&family=Montserrat:wght@800&family=Oswald:wght@700&family=PT+Sans:wght@400;700&family=PT+Serif:wght@700&family=Playfair+Display:wght@700&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root{
  --bg:#e8ecf4;
  --sf:#ffffff;
  --sf-glass:rgba(255,255,255,.78);
  --ink:#16203b;
  --mut:#525d82;
  --ln:#c9d1e4;
  --ac:#2954e0;
  --ac-h:#1e44c4;
  --on:#ffffff;
  --glow:rgba(41,84,224,.22);
  --sh:rgba(12,20,48,.16);
}
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  padding-left:env(safe-area-inset-left,0px);
  padding-right:env(safe-area-inset-right,0px);
}
@media(prefers-color-scheme:dark){
  :root:not([data-theme=light]){
    --bg:#121829;
    --sf:#1c2440;
    --sf-glass:rgba(24,32,56,.82);
    --ink:#edf0fb;
    --mut:#9ba7c9;
    --ln:#36416a;
    --ac:#8aa4ff;
    --ac-h:#a3b8ff;
    --on:#0e1433;
    --glow:rgba(138,164,255,.25);
    --sh:rgba(0,0,0,.42);
  }
}
:root[data-theme=dark]{
  --bg:#121829;
  --sf:#1c2440;
  --sf-glass:rgba(24,32,56,.82);
  --ink:#edf0fb;
  --mut:#9ba7c9;
  --ln:#36416a;
  --ac:#8aa4ff;
  --ac-h:#a3b8ff;
  --on:#0e1433;
  --glow:rgba(138,164,255,.25);
  --sh:rgba(0,0,0,.42);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);overflow-x:hidden}
*,*::before,*::after{box-sizing:inherit}
body{
  margin:0;
  min-height:100dvh;
  background:var(--bg);
  color:var(--ink);
  font:16px/1.42 "PT Sans",system-ui,sans-serif;
  overflow-x:hidden;
  transition:background-color .5s ease,color .35s ease;
}
body::before{
  content:"";
  position:fixed;
  inset:0 0 auto;
  height:env(safe-area-inset-top,0px);
  background:var(--bg);
  z-index:20;
  opacity:.88;
}

/* Ambient animated canvas backdrop */
#bg-cv{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:0;
  pointer-events:none;
}

/* Main layout above ambient background */
header,main{position:relative;z-index:2}
header{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:center;
  justify-content:space-between;
  padding:12px 14px 6px;
  max-width:1040px;
  margin:0 auto;
}
.hdr-r{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
h1{font-size:20px;margin:0;letter-spacing:-.01em}

.seg{display:flex;flex-wrap:wrap;gap:6px}
.chip,.btn,.pri,.tp,.start-btn,.th-btn{
  font:inherit;
  cursor:pointer;
  transition:transform .16s cubic-bezier(.22,1,.36,1),background-color .22s ease,border-color .22s ease,box-shadow .22s ease,color .22s ease;
}
.chip,.th-btn{
  border:1px solid var(--ln);
  background:var(--sf-glass);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  color:var(--ink);
  padding:7px 12px;
  border-radius:999px;
}
.chip:hover,.th-btn:hover,.btn:hover{
  transform:translateY(-1px);
  border-color:var(--ac);
  box-shadow:0 4px 12px var(--sh);
}
.chip:active,.th-btn:active,.btn:active,.pri:active,.tp:active,.start-btn:active{
  transform:scale(.96);
}
.chip[aria-pressed=true]{
  background:var(--ac);
  color:var(--on);
  border-color:var(--ac);
  box-shadow:0 4px 14px var(--glow);
}

/* Stage & 3D Viewport */
.stage{
  position:sticky;
  top:env(safe-area-inset-top,0px);
  z-index:5;
  padding:6px 14px 10px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
  touch-action:pan-y;
}
.book-stage{
  position:relative;
  width:100%;
  max-width:340px;
  height:290px;
  display:flex;
  align-items:center;
  justify-content:center;
  touch-action:pan-y;
  user-select:none;
  -webkit-user-select:none;
  cursor:grab;
}
.book-stage:active{cursor:grabbing}
.book-glow{
  position:absolute;
  width:76%;
  height:76%;
  border-radius:50%;
  background:radial-gradient(circle,var(--stage-glow,rgba(41,84,224,.34)) 0%,transparent 70%);
  filter:blur(22px);
  pointer-events:none;
  transition:background .6s ease,opacity .6s ease;
}
#gl-wrap{
  position:relative;
  width:100%;
  height:100%;
  touch-action:pan-y;
}
#gl-wrap.flying{
  position:fixed;
  inset:0;
  width:100vw;
  height:100dvh;
  z-index:101;
  pointer-events:none;
}
#gl{
  display:block;
  width:100%;
  height:100%;
  touch-action:pan-y;
}
#cv{display:none}

.row{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  justify-content:center;
  min-height:40px;
}
.pri{
  background:var(--ac);
  color:var(--on);
  border:0;
  border-radius:11px;
  padding:10px 16px;
  font-weight:700;
  box-shadow:0 6px 18px var(--glow);
}
.pri:hover{
  background:var(--ac-h);
  transform:translateY(-1px);
  box-shadow:0 8px 22px var(--glow);
}
.rot-btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-weight:700;
  font-size:14px;
  padding:9px 13px;
}
.rot-btn svg{width:16px;height:16px;transition:transform .5s ease}
.rot-btn[aria-pressed=true] svg{animation:spinSlow 6s linear infinite}
@keyframes spinSlow{to{transform:rotate(360deg)}}

#dim,.mut{color:var(--mut);font-size:13px}
#msg{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:13px;
  font-weight:700;
  padding:5px 11px;
  border-radius:999px;
  background:var(--ac);
  color:var(--on);
  opacity:0;
  transform:translateY(6px) scale(.92);
  pointer-events:none;
  transition:opacity .28s ease,transform .28s cubic-bezier(.22,1,.36,1);
}
#msg.show{
  opacity:1;
  transform:translateY(0) scale(1);
}

/* Controls & Panels */
.ctl{padding:4px 14px 32px}
.tabs{margin:4px 0 12px}
.panel{
  background:var(--sf-glass);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  border:1px solid var(--ln);
  border-radius:16px;
  padding:14px;
  box-shadow:0 8px 24px var(--sh);
}
.panel:not([hidden]){animation:panelIn .34s cubic-bezier(.22,1,.36,1) both}
@keyframes panelIn{
  from{opacity:0;transform:translateY(12px)}
  to{opacity:1;transform:translateY(0)}
}

.tg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.tp{
  height:68px;
  border:0;
  border-radius:11px;
  font-weight:700;
  font-size:14px;
  padding:6px;
  box-shadow:0 4px 12px rgba(0,0,0,.14);
}
.tp:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.22)}
.tp[aria-pressed=true]{outline:3px solid var(--ac);outline-offset:2px}

.f{display:grid;gap:5px;margin:0 0 14px}
.f2{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin:0 0 14px}
.f2 label{display:flex;gap:8px;align-items:center;cursor:pointer}
input[type=text],select{
  font:inherit;
  padding:9px 11px;
  border:1px solid var(--ln);
  border-radius:9px;
  background:var(--sf);
  color:var(--ink);
  width:100%;
  transition:border-color .2s ease,box-shadow .2s ease;
}
input[type=text]:focus,select:focus{
  border-color:var(--ac);
  box-shadow:0 0 0 3px var(--glow);
  outline:none;
}
input[type=color]{width:44px;height:34px;padding:0;border:1px solid var(--ln);border-radius:7px;background:none;cursor:pointer}
input[type=range]{width:100%;accent-color:var(--ac);cursor:pointer}
.btn{
  position:relative;
  display:inline-block;
  border:1.5px dashed var(--ac);
  color:var(--ac);
  background:var(--sf);
  border-radius:10px;
  padding:10px 14px;
  margin:0 8px 14px 0;
  font-weight:700;
}
.btn input{position:absolute;opacity:0;width:1px;height:1px}
#ow{
  margin-top:14px;
  background:var(--sf-glass);
  border:1px solid var(--ln);
  border-radius:14px;
  padding:12px;
}
#ow img{max-width:100%;border-radius:8px;margin-top:8px;display:block}
:focus-visible,.btn:has(:focus-visible){outline:3px solid var(--ac);outline-offset:2px}

/* Staggered UI Entrance after splash */
body.intro-active header,
body.intro-active main{
  opacity:0;
  transform:translateY(18px);
  pointer-events:none;
}
body.ui-ready header{animation:staggerUp .55s cubic-bezier(.22,1,.36,1) .04s both}
body.ui-ready .stage{animation:staggerUp .55s cubic-bezier(.22,1,.36,1) .12s both}
body.ui-ready .tabs{animation:staggerUp .55s cubic-bezier(.22,1,.36,1) .20s both}
body.ui-ready .ctl .panel:not([hidden]){animation:staggerUp .55s cubic-bezier(.22,1,.36,1) .28s both}
@keyframes staggerUp{
  from{opacity:0;transform:translateY(18px)}
  to{opacity:1;transform:translateY(0)}
}

/* Full-screen Intro Splash Overlay */
#splash{
  position:fixed;
  inset:0;
  z-index:100;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:max(14px,env(safe-area-inset-top,14px)) max(14px,env(safe-area-inset-right,14px)) max(14px,env(safe-area-inset-bottom,14px)) max(14px,env(safe-area-inset-left,14px));
  background:radial-gradient(circle at 50% 42%,transparent 0%,rgba(10,16,34,.28) 100%);
  transition:opacity .6s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1);
}
#splash.closing{
  opacity:0;
  transform:scale(1.03);
  pointer-events:none;
}
#splash[hidden]{display:none}
.splash-card{
  position:relative;
  z-index:102;
  width:100%;
  max-width:460px;
  border-radius:22px;
  padding:20px 18px 22px;
  background:rgba(255,255,255,.72);
  border:1px solid rgba(255,255,255,.65);
  box-shadow:0 20px 50px rgba(10,18,46,.24);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:14px;
}
@media(prefers-color-scheme:dark){
  :root:not([data-theme=light]) .splash-card{
    background:rgba(18,24,43,.74);
    border-color:rgba(138,164,255,.24);
    box-shadow:0 22px 54px rgba(0,0,0,.55);
  }
}
:root[data-theme=dark] .splash-card{
  background:rgba(18,24,43,.74);
  border-color:rgba(138,164,255,.24);
  box-shadow:0 22px 54px rgba(0,0,0,.55);
}
.splash-top{
  width:100%;
  display:flex;
  justify-content:center;
}
.splash-title{
  margin:0;
  font-size:clamp(22px,5.5vw,28px);
  line-height:1.18;
  font-weight:800;
  letter-spacing:-.02em;
}
.splash-desc{
  margin:0;
  font-size:clamp(14px,3.8vw,15.5px);
  line-height:1.48;
  color:var(--ink);
  opacity:.92;
  max-width:400px;
}
.steps{
  width:100%;
  display:grid;
  grid-template-columns:1fr auto 1fr auto 1fr;
  align-items:center;
  gap:4px;
  padding:10px 8px;
  border-radius:14px;
  background:rgba(125,145,210,.12);
  border:1px solid var(--ln);
}
.step{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  font-size:12px;
  font-weight:700;
  line-height:1.25;
  color:var(--ink);
}
.step-ico{
  width:34px;
  height:34px;
  border-radius:10px;
  display:grid;
  place-items:center;
  background:var(--ac);
  color:var(--on);
  box-shadow:0 4px 12px var(--glow);
}
.step-ico svg{width:18px;height:18px}
.step-arr{
  color:var(--mut);
  font-weight:700;
  font-size:15px;
  user-select:none;
}
.start-btn{
  width:100%;
  max-width:260px;
  border:0;
  border-radius:13px;
  padding:13px 24px;
  font-size:17px;
  font-weight:700;
  background:var(--ac);
  color:var(--on);
  box-shadow:0 10px 26px var(--glow);
}
.start-btn:hover{
  background:var(--ac-h);
  transform:translateY(-2px);
  box-shadow:0 14px 30px var(--glow);
}

@media(min-width:820px){
  main{
    display:grid;
    grid-template-columns:minmax(340px,460px) 1fr;
    gap:28px;
    max-width:1040px;
    margin:0 auto;
    align-items:start;
  }
  .book-stage{
    max-width:440px;
    height:480px;
  }
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:0.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:0.01ms !important;
    scroll-behavior:auto !important;
  }
}
</style>
</head>
