/* Text wrap & fit utilities */
function seg(id,items,cur,fn){
  const el=$(id);if(!el)return;
  el.replaceChildren(...items.map(([l,v])=>{
    const x=E('button',{type:'button',className:'chip',textContent:l});
    x.setAttribute('aria-pressed',v===cur);x.onclick=()=>fn(v);return x}));
}
function wrap(g,txt,mw){
  const o=[];let l='';
  String(txt||'').split(/\s+/).forEach(w=>{
    const t=l?l+' '+w:w;
    if(g.measureText(t).width>mw&&l){o.push(l);l=w}else l=t;
  });
  o.push(l);return o;
}
function fit(g,txt,px,ft,mw){
  let ln=[''];
  for(let i=0;i<40;i++){
    g.font=ft(px);ln=wrap(g,txt,mw);
    if(Math.max(...ln.map(s=>g.measureText(s).width))<=mw)break;
    px*=.94;
  }
  return{ln,px};
}

