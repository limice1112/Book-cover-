}

/* Background Gradient & Bokeh Particle System */
const bgCv=$('#bg-cv'),bgCtx=bgCv.getContext('2d');
let bgW=0,bgH=0;
let curA=hex2rgb(S.a),curB=hex2rgb(S.b),curC=hex2rgb(S.c);
let tgtA=curA.slice(),tgtB=curB.slice(),tgtC=curC.slice();
let bgFadeT=1;
let ptrX=0,ptrY=0,smoothPtrX=0,smoothPtrY=0;

function updateTargetThemeColors(){
  tgtA=hex2rgb(S.a);tgtB=hex2rgb(S.b);tgtC=hex2rgb(S.c);
  bgFadeT=reducedMotion?1:0;
  const glowRgb=lerpRgb(tgtA,tgtB,0.55);
  $('#book-glow').style.setProperty('--stage-glow',rgbStr(glowRgb,isDarkMode()?0.42:0.32));
}

const particles=[];
function initParticles(){
  particles.length=0;
  const isPhone=window.innerWidth<768;
  const count=isPhone?32:54;
  for(let i=0;i<count;i++){
    particles.push({
      x:Math.random(),
      y:Math.random(),
      r:isPhone?(2+Math.random()*5.5):(2.5+Math.random()*7.5),
      vx:(Math.random()-.5)*0.014,
      vy:-0.006-Math.random()*0.014,
      depth:0.3+Math.random()*0.9,
      phase:Math.random()*Math.PI*2,
      alpha:0.14+Math.random()*0.34
    });
  }
}
function resizeBg(){
  const dpr=Math.min(window.devicePixelRatio||1,2);
  bgW=window.innerWidth;bgH=window.innerHeight;
  bgCv.width=Math.round(bgW*dpr);
  bgCv.height=Math.round(bgH*dpr);
  bgCtx.setTransform(dpr,0,0,dpr,0,0);
}
resizeBg();
initParticles();

function renderBg(dt,elapsed){
  if(bgFadeT<1){
    bgFadeT=Math.min(1,bgFadeT+dt/0.6);
    const e=bgFadeT<.5?2*bgFadeT*bgFadeT:1-Math.pow(-2*bgFadeT+2,2)/2;
    curA=lerpRgb(curA,tgtA,Math.min(1,dt*6+e*0.18));
    curB=lerpRgb(curB,tgtB,Math.min(1,dt*6+e*0.18));
    curC=lerpRgb(curC,tgtC,Math.min(1,dt*6+e*0.18));
  }else{
    curA=tgtA;curB=tgtB;curC=tgtC;
  }

  smoothPtrX+=(ptrX-smoothPtrX)*Math.min(1,dt*5);
  smoothPtrY+=(ptrY-smoothPtrY)*Math.min(1,dt*5);

  const dark=isDarkMode();
  const baseBg=dark?[18,24,41]:[232,236,244];
  const mixRatio=dark?0.42:0.24;
  const cTop=lerpRgb(baseBg,curA,mixRatio);
  const cBot=lerpRgb(baseBg,curB,mixRatio*0.95);
  const cOrb=lerpRgb(curB,curC,0.28);

  const shiftX=reducedMotion?0:Math.sin(elapsed*0.35)*bgW*0.06+smoothPtrX*22;
  const shiftY=reducedMotion?0:Math.cos(elapsed*0.28)*bgH*0.05+smoothPtrY*18;

  const grad=bgCtx.createLinearGradient(0,0,bgW*0.4+shiftX,bgH);
  grad.addColorStop(0,rgbStr(cTop));
  grad.addColorStop(1,rgbStr(cBot));
  bgCtx.fillStyle=grad;
  bgCtx.fillRect(0,0,bgW,bgH);

  const orbX=bgW*0.5+shiftX*1.4;
  const orbY=bgH*0.36+shiftY*1.4;
  const orbR=Math.max(bgW,bgH)*0.55;
  const rad=bgCtx.createRadialGradient(orbX,orbY,10,orbX,orbY,orbR);
  rad.addColorStop(0,rgbStr(cOrb,dark?0.24:0.26));
  rad.addColorStop(0.55,rgbStr(curA,dark?0.10:0.08));
  rad.addColorStop(1,rgbStr(baseBg,0));
  bgCtx.fillStyle=rad;
  bgCtx.fillRect(0,0,bgW,bgH);

  for(let i=0;i<particles.length;i++){
    const p=particles[i];
    if(!reducedMotion){
      p.x+=p.vx*dt;
      p.y+=p.vy*dt;
      if(p.x<-0.05)p.x=1.05;
      if(p.x>1.05)p.x=-0.05;
      if(p.y<-0.05)p.y=1.05;
      if(p.y>1.05)p.y=-0.05;
    }
    const px=p.x*bgW+smoothPtrX*28*p.depth;
    const py=p.y*bgH+smoothPtrY*22*p.depth;
    const pulse=reducedMotion?1:(0.78+0.22*Math.sin(elapsed*1.5+p.phase));
    const radP=bgCtx.createRadialGradient(px,py,0,px,py,p.r*2.2);
    const pCol=dark?lerpRgb(curC,[255,255,255],0.35):lerpRgb(curB,curC,0.4);
    radP.addColorStop(0,rgbStr(pCol,p.alpha*pulse));
    radP.addColorStop(1,rgbStr(pCol,0));
    bgCtx.fillStyle=radP;
    bgCtx.beginPath();
    bgCtx.arc(px,py,p.r*2.2,0,Math.PI*2);
    bgCtx.fill();
  }
}

